# Local development database (Docker)
DATABASE_URL=postgresql://user:password@localhost:5432/whatsfiled

# Trigger.dev API key (optional, for pipeline status page)
TRIGGER_SECRET_KEY=

# Better Auth configuration
# Generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth credentials (optional, from Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin email allowlist (comma-separated, optional)
ADMIN_EMAILS=

# Supabase for realtime chat (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
